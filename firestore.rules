rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public site content, synced from the admin portal
    match /site_data/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Newsletter / alliance subscribers
    match /subscribers/{doc} {
      allow create: if true;
      allow read, delete: if true;
    }

    // Sponsorship inquiries submitted from the sponsor page
    match /sponsor_inquiries/{doc} {
      allow create, read: if true;
    }

    // Public sponsor inquiries
    match /sponsor_inquiries/{inquiryId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.companyName is string;
      allow read, update, delete: if request.auth != null;
    }
  }
}
