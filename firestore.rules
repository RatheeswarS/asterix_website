rules_version = '2';

// These rules previously left `site_data` world-writable and the subscriber list
// world-readable and world-deletable. The Firebase web config is committed to
// this repository, so both were reachable from any browser console by anyone who
// had seen the source.
//
// Firestore is only a fallback sync path here; MongoDB Atlas is the server of
// record. Writes therefore require an authenticated session, and everything that
// holds personal data is closed to public reads.
//
// Rules take effect only once deployed:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Public site content, synced from the admin portal.
    // Readable by the site; writable only by a signed-in admin.
    match /site_data/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Newsletter / alliance subscribers. Anyone may sign up; only an
    // authenticated admin may read the list or remove an entry.
    match /subscribers/{doc} {
      allow create: if request.resource.data.email is string;
      allow read, update, delete: if request.auth != null;
    }

    // Sponsorship inquiries submitted from the sponsor page. Submitting is
    // public; reading them is not.
    match /sponsor_inquiries/{inquiryId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.companyName is string;
      allow read, update, delete: if request.auth != null;
    }

    // Recruitment data lives in MongoDB behind the /api/recruitment routes,
    // which enforce the per-track gating and the submission deadlines. It is
    // never mirrored here, and nothing should create it.
    match /recruitment/{doc=**} {
      allow read, write: if false;
    }
  }
}
