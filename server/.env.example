PORT=5000

# Required in production. There is no hardcoded fallback any more: if this is
# unset the server still starts, but signs with a random key generated at boot,
# so every admin session ends on restart.
JWT_SECRET=your_jwt_secret_key_here

# Enforced. An origin not listed here (and not a *asterix*.vercel.app preview)
# is refused.
CORS_ORIGIN=http://localhost:5173,https://asterix-website.vercel.app

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/asterix?retryWrites=true&w=majority

# One-time bootstrap for the first administrator, replacing the hardcoded
# credentials that used to be accepted. With this set, signing in as
# ADMIN_BOOTSTRAP_USERNAME (default "admin") with this exact password creates
# that account if it does not already exist. Unset it once the account exists.
# The alternative is: node src/scripts/setAdminPassword.js '<password>'
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=

# ImageKit CDN Integration for Photo Uploads
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_imagekit_id>

# Optional custom persistent paths for cloud hosts (e.g. /var/data, /var/data/uploads)
# DATA_DIR=/var/data
# UPLOADS_DIR=/var/data/uploads


